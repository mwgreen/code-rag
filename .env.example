# Milvus Configuration
MILVUS_DB_PATH=./data/milvus.db

# File Extensions to Index (comma-separated)
DEFAULT_EXTENSIONS=.java,.js,.ts,.jsx,.tsx,.json,.xml,.yaml,.yml,.md,.properties,.gradle,.html

# Directories to Exclude (comma-separated)
EXCLUDE_DIRS=node_modules,__pycache__,.git,venv,.venv,target,build,dist,.idea,.vscode

# Chunk Size Configuration
MAX_CHUNK_SIZE=3000
MIN_CHUNK_SIZE=50

# ---------------------------------------------------------------------------
# Model selection (all optional). With nothing set, the best already-downloaded
# models are used, falling back to the "high" profile on a fresh machine.
# List options and see what resolves:  venv/bin/python model_config.py --list
#
# Profiles:
#   max     64 GB+   Qwen3-Embedding-4B + Qwen3.6-35B-A3B
#   high    48 GB    Qwen3-Embedding-4B + Gemma 4 E4B        (default)
#   medium  24-32 GB Qwen3-Embedding-0.6B + Gemma 4 E4B
#   low     16 GB    Qwen3-Embedding-0.6B + Gemma 4 E2B
#   legacy  32 GB    SFR-Embedding-Code-2B + Gemma 3 4B      (pre-Sept-2026 defaults)
#CODE_RAG_PROFILE=high

# Pick individual models by registry key (overrides the profile):
#CODE_RAG_EMBED_MODEL=qwen3-embed-4b
#CODE_RAG_DESCRIPTION_MODEL_KEY=gemma-4-e4b

# Or point at anything directly (overrides everything above):
#EMBED_MODEL_PATH=/absolute/path/to/mlx-embedding-model
#CODE_RAG_DESCRIPTION_MODEL=mlx-community/some-mlx-lm-model

# Turn NL descriptions off entirely (indexing is much faster, search a bit worse):
#CODE_RAG_DESCRIPTIONS=0

# ---------------------------------------------------------------------------
# Runtime tuning (defaults shown)
#CODE_RAG_EMBED_MAX_TOKENS=2048        # truncate chunks at this many tokens before embedding
#CODE_RAG_EMBED_BATCH=8                # chunks per embedding forward pass
#CODE_RAG_DESCRIPTION_IDLE_UNLOAD=600  # seconds idle before the description model is unloaded (server)
#CODE_RAG_RECONCILE_INTERVAL=21600     # seconds between periodic disk/index/FTS reconciles (0 = off)
#CODE_RAG_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING
#CODE_RAG_NODE=/opt/homebrew/bin/node  # node binary for code-chunk (auto-detected)
#CODE_RAG_CHUNKER_TIMEOUT=60           # seconds before a stuck chunker request restarts the node process
#CODE_RAG_START_TIMEOUT=180            # launcher: seconds to wait for /health after start
